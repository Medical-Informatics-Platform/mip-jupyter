# Only tracked workspace files may reach the image: the single-user Dockerfile
# COPYs workspace/ into every new home, and local runs leave tokens, chats,
# scratch and a docs symlink there. The patterns below still apply inside.
workspace/*
!workspace/Welcome.ipynb
!workspace/examples/

.git
.github
.codegraph
.llm
scripts
docker/hub/test_*.py
python-client/tests
python-client/verify_script.py
python-client/conftest.py
mip_jupyter_dev/test_*.py
**/*.chat

# Virtualenvs (be explicit — nested client .venv is ~290MB)
.venv
.venv/
**/.venv
**/.venv/
venv
**/venv
**/venv/
env
ENV

__pycache__
**/__pycache__
*.py[cod]
*.pyo
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov
.tox
.nox
.hypothesis
build
dist
*.egg-info
**/*.egg-info
pip-wheel-metadata
.ipynb_checkpoints
**/.ipynb_checkpoints

**/.env
**/.env.*
**/.mip_token
**/mip_token
.cursor
.aider*
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Root uv.lock is used by `uv sync --locked`; the client's own lock is not.
python-client/uv.lock
